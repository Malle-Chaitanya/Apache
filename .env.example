# ─────────────────────────────────────────────────────────────
# ITSM Migrator — environment configuration
# Copy to .env and fill in. With no .env the app runs in
# STORE=memory + DRIVER=mock so you can demo with zero services.
# ─────────────────────────────────────────────────────────────

PORT=4000

# Persistence: "memory" (in-process, demo) or "mongo" (real).
STORE=memory
# When STORE=mongo, provide a DEV/local URI (never a prod credential in a repo).
MONGODB_URI=mongodb://localhost:27017/itsm_migrator

# Connector driver: "mock" (bundled fixtures) or "live" (real APIs).
DRIVER=mock

# ── Zendesk (source) — required when DRIVER=live ──
ZENDESK_SUBDOMAIN=acme
ZENDESK_EMAIL=admin@acme.com
ZENDESK_API_TOKEN=

# ── Freshdesk (target) — required when DRIVER=live ──
FRESHDESK_DOMAIN=acme
FRESHDESK_API_KEY=

# Rate limits (requests/min) — calibrate to the target plan.
ZENDESK_RPM=650
FRESHDESK_RPM=600

# Batch size for bulk phases.
BATCH_SIZE=100
