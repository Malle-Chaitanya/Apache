# ─────────────────────────────────────────────────────────────
# ITSM Migrator — environment configuration (production)
# Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

PORT=4400

# Persistence
STORE=mongo
# Mongo connection is assembled from these parts (the app URL-encodes the
# password, so special chars like @ are safe). Only MONGO_HOST/PORT change per
# environment:  local dev = localhost:27018 · Docker = mongodb:27017 (set by
# compose) · production = your managed host.
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USERNAME=Admin
MONGO_PASSWORD=change-me
MONGO_DATABASE=itsm_migrator
# Full override (wins over the parts above) — e.g. MongoDB Atlas in production:
# MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/itsm_migrator

# ── Secrets ──
# Backend that holds customer credentials. 'mongo' = AES-256-GCM encrypted in
# Mongo (dev). Swap to a KMS-backed store in production (SECRET_BACKEND=aws|vault|azure).
SECRET_BACKEND=mongo
# 32 random bytes, base64. DEV ONLY — in production source this from a KMS.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MIGRATION_SECRET_KEY=

# ── Portal login (Layer 1) ──
# Secret used to sign session JWTs. Use a long random value in production.
JWT_SECRET=

# ── OAuth (register-once app credentials; per platform) ──
OAUTH_REDIRECT_URI=http://localhost:4400/api/oauth/callback
# Zendesk global OAuth client
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Atlassian (Jira Service Management) 3LO app
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Batch size for bulk phases
BATCH_SIZE=100

# NOTE: Freshdesk / Freshservice have NO OAuth — customers supply an API key at
# connect time (stored encrypted). ServiceNow uses a per-instance OAuth registry.
# Nothing to configure here for those; the ConnectionManager handles them.
